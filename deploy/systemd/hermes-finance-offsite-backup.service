[Unit]
Description=Encrypted Hermes Finance off-site backup and restore verification
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/hermes-workspace-deploy
EnvironmentFile=-/home/ubuntu/.hermes/.env
ExecStart=/home/ubuntu/.hermes/node/bin/pnpm run finance:offsite-backup
