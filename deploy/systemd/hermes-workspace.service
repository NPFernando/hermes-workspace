[Unit]
Description=Hermes Workspace UI (port 3000)
After=network.target hermes-gateway.service hermes-web.service
Wants=hermes-gateway.service hermes-web.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/hermes-workspace-live
EnvironmentFile=/home/ubuntu/hermes-workspace-live/.env
# Guard against orphaned processes left over from a previous failed restart
# holding port 3000 (this caused a 5+ hour outage on 2026-07-01: an untracked
# process squatted the port, all 5 systemd restart attempts hit EADDRINUSE,
# and the unit was marked failed while the stale process kept serving old assets).
# `fuser -k` only sends the kill signal — it doesn't wait for the process to
# actually exit and release the socket, so a single fixed `sleep 1` was still
# racing slow-to-exit processes (observed EADDRINUSE restarts in the journal
# on 2026-09-06). Poll for up to 5s until the port is actually free instead
# of blindly sleeping a fixed amount.
ExecStartPre=-/usr/bin/fuser -k 3000/tcp
ExecStartPre=/bin/bash -c 'for i in $(seq 1 10); do /usr/bin/fuser 3000/tcp >/dev/null 2>&1 || exit 0; sleep 0.5; done; exit 0'
ExecStart=/home/ubuntu/.hermes/node/bin/node /home/ubuntu/hermes-workspace-live/server-entry.js
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
