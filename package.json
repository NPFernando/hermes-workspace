{
  "name": "hermes-workspace",
  "version": "2.4.0",
  "description": "Desktop workspace for Hermes Agent — chat, orchestration, and multi-agent coding pipelines",
  "author": "Eric (https://github.com/outsourc-e)",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && find dist/client/assets -name '*.js' -o -name '*.css' -o -name '*.svg' | xargs -P4 gzip -9 -k -f",
    "start:all": "concurrently \"hermes gateway run\" \"pnpm dev\" \"bash scripts/start-odysseus.sh\"",
    "start": "node server-entry.js",
    "start:dev": "vite dev",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:finance": "vitest run src/server/finance-store.test.ts src/server/finance-extraction.test.ts src/server/finance-postgres-store.test.ts src/server/finance-storage-monitor.test.ts src/server/harp-memory-client.test.ts src/server/trading-readiness.test.ts src/routes/api/-finance.test.ts src/routes/api/-finance-learned-facts.test.ts src/screens/personal-finance/utils.test.ts src/screens/personal-finance/components/-assistant-memory-card.test.tsx",
    "test:e2e:finance": "node scripts/finance-browser-e2e.mjs",
    "test:e2e:agent-cockpit": "node scripts/agent-cockpit-browser-e2e.mjs",
    "test:e2e:auth": "node scripts/authenticated-browser-smoke.mjs",
    "test:pg-integration": "tsx scripts/finance-pg-integration.ts",
    "finance:postgres-backup-restore": "tsx scripts/finance-pg-backup-restore.ts",
    "finance:offsite-backup": "tsx scripts/finance-offsite-backup.ts",
    "dr:exercise": "tsx scripts/disaster-recovery-exercise.ts",
    "finance:offsite-backup:configure": "bash scripts/configure-finance-offsite-backup.sh",
    "finance:audit-retention": "tsx scripts/finance-audit-retention.ts",
    "fork-sync:preview": "python3 scripts/fork_sync_scheduled_preview.py",
    "fork-sync:approve": "python3 scripts/fork_sync_approval.py",
    "security:deployment-gate": "node scripts/deployment-security-gate.mjs",
    "swarm-queue:provision": "node scripts/provision-swarm-dispatch-queue.mjs",
    "swarm-queue:migrate": "node scripts/migrate-swarm-dispatch-queue.mjs",
    "test:queue:isolated": "bash scripts/test-swarm-queue-isolated.sh",
    "finance:postgres-cutover": "tsx scripts/finance-postgres-cutover.ts",
    "finance:storage-monitor-smoke": "tsx scripts/finance-storage-monitor-smoke.ts",
    "smoke:managed": "node scripts/managed-companion-smoke.mjs",
    "smoke:auth:browser": "node scripts/authenticated-browser-smoke.mjs",
    "smoke:release": "node scripts/release-smoke.mjs",
    "release:check": "node scripts/release-checklist.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:build-integrity": "node scripts/check-build-integrity.mjs",
    "secrets:status": "node scripts/secrets-status.mjs",
    "secrets:rotation": "node scripts/secrets-rotation.mjs",
    "check:accessibility": "node scripts/check-theme-contrast.mjs",
    "check:accessibility:browser": "node scripts/accessibility-browser-smoke.mjs",
    "check:pwa": "node scripts/check-pwa.mjs",
    "check:pwa:browser": "node scripts/pwa-browser-smoke.mjs",
    "ops:monitor": "node scripts/ops-monitor.mjs",
    "playground:ws": "node scripts/playground-ws.mjs",
    "lint": "eslint",
    "format": "prettier",
    "check": "prettier --write . && eslint --fix",
    "electron:dev": "electron .",
    "electron:build": "pnpm build && pnpm electron:bundle-server && electron-builder --config electron-builder.config.cjs",
    "electron:build:mac": "pnpm build && pnpm electron:bundle-server && electron-builder --mac --config electron-builder.config.cjs",
    "electron:build:win": "pnpm build && pnpm electron:bundle-server && electron-builder --win --config electron-builder.config.cjs",
    "electron:bundle-server": "node scripts/build-electron-server-bundle.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.2",
    "@hugeicons/react": "^1.1.10",
    "@lobehub/icons": "^5.18.0",
    "@lobehub/icons-static-png": "^1.97.0",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.36",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-router-ssr-query": "1.167.2",
    "@tanstack/react-start": "1.168.53",
    "@tanstack/react-virtual": "^3.14.12",
    "@tanstack/router-plugin": "1.168.38",
    "@types/react-grid-layout": "^1.3.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "framer-motion": "^13.2.0",
    "marked": "^18.0.13",
    "mermaid": "^12.0.0",
    "motion": "^12.29.2",
    "motion-dom": "^13.2.0",
    "motion-utils": "^13.3.0",
    "pg": "^8.23.0",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-joyride": "^2.9.3",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "vite-tsconfig-paths": "^6.0.2",
    "ws": "^8.21.3",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-search": "^0.13.0",
    "xterm-addon-web-links": "^0.9.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tanstack/eslint-config": "0.4.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "vite": "^8.3.0",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^5.0.0",
    "web-vitals": "^6.2.1"
  }
}
