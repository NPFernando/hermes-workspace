{
  "name": "hermes-workspace",
  "version": "2.4.0",
  "description": "Desktop workspace for Hermes Agent — chat, orchestration, and multi-agent coding pipelines",
  "author": "Eric (https://github.com/outsourc-e)",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/check-bundle-budget.mjs && find dist/client/assets -name '*.js' -o -name '*.css' -o -name '*.svg' | xargs -P4 gzip -9 -k -f",
    "start:all": "concurrently \"hermes gateway run\" \"pnpm dev\" \"bash scripts/start-odysseus.sh\"",
    "start": "node server-entry.js",
    "start:dev": "vite dev",
    "preview": "vite preview",
    "test": "vitest run",
    "test:collection": "node scripts/check-vitest-collection.mjs",
    "check:task-api-guards": "node scripts/check-task-api-guards.mjs",
    "check:json-api-guards": "node scripts/check-json-api-guards.mjs",
    "check:mutation-api-auth": "node scripts/check-mutation-api-auth.mjs",
    "test:dify": "vitest run src/routes/api/-dify.test.ts src/server/dify-client.test.ts src/server/dify-audit.test.ts",
    "smoke:dify": "node scripts/dify-smoke.mjs",
    "smoke:dify:browser": "node scripts/dify-browser-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "test:pg-integration": "tsx scripts/personal-finance-pg-integration.ts",
    "finance:postgres-cutover": "tsx scripts/finance-postgres-cutover.ts",
    "finance:backup:encrypted": "tsx scripts/finance-encrypted-backup.ts",
    "finance:restore:encrypted": "tsx scripts/finance-restore-encrypted.ts",
    "smoke:managed": "node scripts/managed-companion-smoke.mjs",
    "smoke:release": "node scripts/release-smoke.mjs",
    "smoke:browser": "node scripts/browser-smoke.mjs",
    "smoke:auth:browser": "node scripts/authenticated-browser-smoke.mjs",
    "smoke:queue:browser": "node scripts/queue-browser-smoke.mjs",
    "smoke:dashboard:browser": "node scripts/dashboard-browser-smoke.mjs",
    "verify:live": "bash scripts/verify-live-deployment.sh",
    "check:service-drift": "bash scripts/check-service-unit-drift.sh",
    "playground:ws": "node scripts/playground-ws.mjs",
    "lint": "eslint",
    "lint:changed": "node scripts/lint-changed.mjs",
    "lint:critical": "eslint src/routes/api/finance.ts src/routes/api/auth.ts src/server/finance-store.ts src/server/personal-finance-store.ts src/server/personal-finance-postgres-store.ts src/server/auth-middleware.ts",
    "lint:ui-critical": "eslint src/screens/dashboard/components/model-info-card.tsx src/screens/dashboard/components/sessions-intelligence-card.tsx src/screens/gateway/components/office-view.tsx src/screens/mcp/components/sources-manager-dialog.tsx src/screens/profiles/profiles-screen.tsx src/screens/skills/skills-screen.tsx src/screens/skills/workspace-skills-screen.tsx src/stores/mission-store.ts",
    "format": "prettier",
    "check": "prettier --write . && eslint --fix",
    "electron:dev": "electron .",
    "electron:build": "pnpm build && pnpm electron:bundle-server && electron-builder --config electron-builder.config.cjs",
    "electron:build:mac": "pnpm build && pnpm electron:bundle-server && electron-builder --mac --config electron-builder.config.cjs",
    "electron:build:win": "pnpm build && pnpm electron:bundle-server && electron-builder --win --config electron-builder.config.cjs",
    "electron:bundle-server": "esbuild dist/server/server.js --bundle --platform=node --format=cjs --outfile=electron/server-bundle.cjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.1.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource/eb-garamond": "^5.2.7",
    "@hugeicons/core-free-icons": "^3.1.1",
    "@hugeicons/react": "^1.1.4",
    "@lobehub/icons": "^5.0.1",
    "@lobehub/icons-static-png": "^1.83.0",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "5.90.21",
    "@tanstack/history": "1.162.3",
    "@tanstack/react-router": "1.170.34",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/react-router-ssr-query": "1.167.2",
    "@tanstack/react-start": "1.168.51",
    "@tanstack/react-virtual": "^3.14.4",
    "@tanstack/router-plugin": "1.168.37",
    "@types/react-grid-layout": "^1.3.6",
    "class-variance-authority": "^0.7.1",
    "cookie-es": "2.0.0",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "framer-motion": "^12.36.0",
    "marked": "^17.0.1",
    "mermaid": "^11.17.2",
    "motion": "^12.29.2",
    "motion-dom": "^12.36.0",
    "motion-utils": "^12.36.0",
    "pg": "^8.22.0",
    "playwright": "^1.58.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-joyride": "^2.9.3",
    "react-markdown": "^10.1.0",
    "recharts": "^3.7.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.21.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "vite-tsconfig-paths": "^6.0.2",
    "ws": "^8.21.3",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-search": "^0.13.0",
    "xterm-addon-web-links": "^0.9.0",
    "yaml": "^2.8.3",
    "zod": "^3.25.76",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tanstack/eslint-config": "0.3.4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^8.2.2",
    "electron": "^40.8.2",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.27.0",
    "eslint": "^10.2.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.5.3",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vite": "^7.3.6",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^3.0.5",
    "web-vitals": "^5.1.0"
  }
}
